# URL de l'API backend en production.
# En développement, laisser vide : le proxy Vite (/api) le gère.
VITE_API_URL=

# Cloudinary — upload non signé des photos d'activité (Sprint 3).
# Valeurs par défaut codées dans src/services/cloudinary.ts ; à surcharger seulement
# si vous changez de cloud ou de preset.
VITE_CLOUDINARY_CLOUD_NAME=ddnolovmg
VITE_CLOUDINARY_UPLOAD_PRESET=rony_hair_uploads
